# Gallery API. Runs the Hono server against DATABASE_URL.
# Build: docker build -f Dockerfile.api -t blade-gallery-api .
# Run:   docker run -e DATABASE_URL=... -p 3001:3001 blade-gallery-api
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
# Full install: tsx (dev dep) runs the TS server directly, no build step.
RUN npm ci
COPY server/ ./server/
COPY db/ ./db/
ENV PORT=3001
EXPOSE 3001
CMD ["node", "--import", "tsx/esm", "server/index.ts"]
