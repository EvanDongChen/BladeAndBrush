{
  "name": "blade-and-brush",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint && vitest run",
    "test:watch": "vitest",
    "db:migrate": "node db/migrate.mjs",
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "bench": "vitest run --config bench/vitest.config.ts",
    "bench:baseline": "node -e \"require('fs').copyFileSync('bench/results/latest.json','bench/baseline.json')\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
