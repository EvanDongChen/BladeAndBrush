# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Local Postgres (docker compose) or Tiger Data cloud.
DATABASE_URL=postgres://user:password@localhost:5432/bladeandbrush
# API server port (Vite proxies /api here in dev).
PORT=3001
# Gallery frontend base URL override (default: same-origin /api).
# VITE_GALLERY_API=http://localhost:3001/api
# Object bucket for PNGs (S3-compatible). Unset = store data URLs directly.
# BUCKET_ENDPOINT=
# BUCKET_NAME=
# BUCKET_ACCESS_KEY=
# BUCKET_SECRET_KEY=
